---

---

<style is:global>
  :root {
    --h-header: 52px;
    --h-footer: 120px;

    --blockquote-bg: #f9f9f9;
    --pre-bg: #fafafa;
  }

  :root.dark {
    --blockquote-bg: #313131;
    --pre-bg: #1f1f1f;
  }

  svg {
    max-width: unset !important;
  }

  img.medium-zoom-image--opened {
    z-index: 999;
  }

  pre {
    line-height: 1.4 !important;
  }

  @keyframes pageFadeUpOut {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-20px);
    }
  }

  @keyframes pageFadeUpIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pageFadeDownOut {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @keyframes pageFadeDownIn {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  [data-astro-transition="vertical-up"]::view-transition-old(page-main) {
    mix-blend-mode: normal;
    animation: pageFadeUpOut 180ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  [data-astro-transition="vertical-up"]::view-transition-new(page-main) {
    mix-blend-mode: normal;
    animation: pageFadeUpIn 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  [data-astro-transition="vertical-down"]::view-transition-old(page-main) {
    mix-blend-mode: normal;
    animation: pageFadeDownOut 180ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  [data-astro-transition="vertical-down"]::view-transition-new(page-main) {
    mix-blend-mode: normal;
    animation: pageFadeDownIn 220ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }
</style>
