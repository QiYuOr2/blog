---
import PageLayout from "@/layouts/page.astro";
import PostList from "@/features/posts/components/post-list.vue";
import { visibleFilter, getPostCreatedYear } from "@/features/posts/model";
import { externalPosts } from "@/externals";
import { getCollection } from "astro:content";

const _posts = await getCollection("posts");
const posts = Object.groupBy(
  [..._posts.filter(visibleFilter), ...externalPosts],
  getPostCreatedYear,
);
---

<PageLayout post>
  <PostList posts={posts} />
</PageLayout>
